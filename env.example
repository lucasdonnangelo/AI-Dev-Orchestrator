# =============================================================================
# AI Dev Orchestrator — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Anthropic API key (required)
# Get yours at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Model for Planner and Reviewer (optional, default below)
ORCHESTRATOR_MODEL=claude-sonnet-4-6

# Max retry attempts when Reviewer rejects code (optional, default: 3)
ORCHESTRATOR_MAX_RETRIES=3

# Log level: DEBUG, INFO, WARNING, ERROR (optional, default: INFO)
ORCHESTRATOR_LOG_LEVEL=INFO
